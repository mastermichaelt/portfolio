# Optional PostHog (Portfolio Projects). Leave blank for local/CI no-op.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional Gemini API key for the dev-only image and video generators
# (docs/image-generation.md, docs/video-generation.md). Server-side dev tooling
# only — never referenced by app/ code and never sent to the client. Leave blank
# unless you are generating portfolio assets locally. Video generation (Veo)
# additionally requires that the key has Veo access.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
