# Canonical production origin for metadata, analytics fallback, and OG assets.
# Defaults to https://michaeltruong.ai when unset.
NEXT_PUBLIC_SITE_URL=

# Optional PostHog (Portfolio Projects). Leave blank for local/CI no-op.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional Gemini API key for the dev-only image and video generators
# (docs/image-generation.md, docs/video-generation.md). Server-side dev tooling
# only — never referenced by app/ code and never sent to the client. Leave blank
# unless you are generating portfolio assets locally. Video generation (Veo)
# additionally requires that the key has Veo access.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Assistant retrieval index (dev tooling only — not used by app/ or Vercel deploy).
# Local: docker compose up -d, then npm run assistant:db:migrate
# Default matches docker-compose.yml (port 5433).
# Schema uses vector(1536) for text-embedding-3-small; changing model/dimensions
# requires a migration and full re-embed — not interchangeable via env alone.
DATABASE_URL=postgresql://portfolio:portfolio_dev@localhost:5433/portfolio_assistant
