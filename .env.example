# Canonical production origin for metadata, analytics fallback, and OG assets.
# Defaults to https://michaeltruong.ai when unset.
NEXT_PUBLIC_SITE_URL=

# Optional PostHog (Portfolio Projects). Leave blank for local/CI no-op.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional Gemini API key for the dev-only image and video generators
# (docs/image-generation.md, docs/video-generation.md). Server-side dev tooling
# only — never referenced by app/ code and never sent to the client. Leave blank
# unless you are generating portfolio assets locally. Video generation (Veo)
# additionally requires that the key has Veo access.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Assistant retrieval index ONLY (dev tooling — not site PortfolioRepository).
# Separate from future site persistence; do not reuse for Milestone 4 Postgres.
# Local default: docker compose up -d, then npm run assistant:db:migrate
# Hosted: Neon assistant retrieval database (neon-deployment slice) — set via
# gitignored .env or secrets; never commit connection strings.
# Same migrations apply to local Docker and hosted Neon via DATABASE_URL.
# Schema: vector(1536) for text-embedding-3-small; model/dimension changes need
# a migration and full re-embed. Verify: npm run assistant:db:verify
# Docs: docs/assistant/assistant-database.md
DATABASE_URL=postgresql://portfolio:portfolio_dev@localhost:5433/portfolio_assistant

# Destructive ingest integration tests only (npm test). Must be a dedicated database
# whose name ends in _test — never the dev/Neon retrieval index above.
# Local: portfolio_assistant_test (created by docker/postgres-init on first compose up).
# ASSISTANT_TEST_DATABASE_URL=postgresql://portfolio:portfolio_dev@localhost:5433/portfolio_assistant_test
# Neon test DB (optional): requires ASSISTANT_TEST_ALLOW_NEON=1 in addition to *_test name.

# Assistant embeddings (dev tooling — ingest / retrieve slices). Never commit keys.
# Model must stay text-embedding-3-small (1536 dims) unless the pgvector schema migrates.
OPENAI_API_KEY=
# ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
