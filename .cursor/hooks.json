{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "sh .cursor/hooks/ensure-git-hooks.sh",
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": "sh .cursor/hooks/format.sh \"$CURSOR_FILE_PATH\"",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "[ ! -f \".cursor/skills/impeccable/scripts/impeccable\" ] || \".cursor/skills/impeccable/scripts/impeccable\" hook-before-edit",
        "timeout": 5
      }
    ]
  }
}
