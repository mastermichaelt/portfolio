{
  "name": "portfolio",
  "version": "0.1.0",
  "description": "Personal engineering portfolio — michaeltruong.ai",
  "homepage": "https://michaeltruong.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastermichaelt/portfolio.git"
  },
  "author": "Michael Truong <michael@multipliers.dev>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "verify:social-metadata": "node scripts/verify-prerendered-social-metadata.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium",
    "generate:image": "node scripts/generate-image.mjs",
    "generate:video": "node scripts/generate-video.mjs",
    "generate:connect-qr": "node --experimental-strip-types scripts/generate-connect-qr.mjs",
    "generate:connect-manifest": "node --experimental-strip-types scripts/generate-connect-manifest.mjs",
    "generate:connect-icons": "node --experimental-strip-types scripts/generate-connect-icons.mjs",
    "generate:connect-portrait": "node scripts/generate-connect-portrait.mjs",
    "prepare": "sh scripts/prepare-git-hooks.sh",
    "verify:git-hooks": "sh scripts/verify-git-hooks.sh",
    "okf:build": "node --experimental-strip-types --import ./scripts/assistant/okf/register-tsconfig-paths.mjs scripts/assistant/okf/build.mjs",
    "assistant:derive": "node scripts/assistant/retrieval/derive-units.mjs",
    "assistant:db:migrate": "node scripts/assistant/db/migrate.mjs",
    "assistant:db:verify": "node scripts/assistant/db/verify.mjs",
    "assistant:ingest": "node scripts/assistant/ingest.mjs",
    "assistant:retrieve": "node scripts/assistant/retrieve.mjs",
    "assistant:answer": "node scripts/assistant/answer.mjs",
    "renovate:freshness-poll": "renovate-workflow freshness-poll"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "16.3.0",
    "posthog-js": "^1.414.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@google/genai": "^2.24.0",
    "@multipliers-dev/renovate-workflow": "^0.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsqr": "^1.4.0",
    "lint-staged": "^17.3.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{cjs,js,jsx,mjs,ts,tsx}": [
      "prettier --write"
    ],
    "*.{css,html,json,md,yml,yaml}": "prettier --write"
  }
}
